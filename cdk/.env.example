# Local deployment configuration for the AIDLC platform CDK app.
#
# Copy this file to 'cdk/.env' and fill in your real values:
#     cp cdk/.env.example cdk/.env
#
# 'cdk/.env' is git-ignored, so your real AWS account id is stored locally and
# never committed or shared. The tracked source uses a placeholder account.
#
# AIDLC_DEPLOY_ACCOUNT is read by cdk/bin/cdk.ts and treated as an explicit
# account override (equivalent to passing '-c account=<id>'), so deploys work
# without editing tracked source or passing the flag every time.
#
# Load it into your shell before deploying, e.g.:
#     set -a; source cdk/.env; set +a
#     yarn deploy-infrastructure

AIDLC_DEPLOY_ACCOUNT=123456789012

# Optional. Defaults to us-east-1 when unset.
CDK_DEFAULT_REGION=us-east-1
